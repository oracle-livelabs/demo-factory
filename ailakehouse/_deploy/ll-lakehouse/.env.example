# Permanent own-tenancy configuration for /home/opc/.env.
#
# Copy this file to /home/opc/.env, replace every <...> placeholder, then run:
#   chmod 600 /home/opc/.env
#   bash inst.sh
#
# Do not commit the completed file. Use your own short-lived, read-only archive
# URLs; do not reuse LiveLabs URLs or credentials. OCI metadata still takes
# precedence for Terraform, OCI Marketplace, and LiveLabs deployments.

# Required Autonomous Database settings. The wallet must use DBPASSWORD and
# contain the service alias derived from dbnamelocal.
DBPASSWORD="<autonomous-database-admin-password>"
dbconnectionlocal="<full-autonomous-database-connection-string>"
dbnamelocal="<autonomous-database-name>"
# Set one of these when the Data Transforms URL cannot be derived from the ADB
# connection string. BASEURL is the Oracle Database Actions base URL.
# ordsurllocal="<autonomous-database-ords-url>"
# baseurllocal="https://<adb-host>-<database-name>.adb.<region>.oraclecloudapps.com"
# Use either a read-only HTTPS URL or an absolute path already copied to the VM.
adbwallet="<read-only-adb-wallet-zip-url-or-absolute-local-path>"

# AI Hub custom-image choice. PostgreSQL, MySQL, Data Sources, and AWS Glue
# integration are always included. Set to true before running inst.sh to also
# bake the optional MongoDB catalog source on port 27017 into the image.
AIHUB=false

# Required OCI Generative AI API-key settings. Keep the PEM value quoted;
# literal newlines are supported. The current automatic profile-creation path
# supports API-key authentication.
pem_keylocal="<oci-api-private-key-pem>"
pem_key_fingerprintlocal="<oci-api-key-fingerprint>"
user_ocidlocal="<oci-user-ocid>"
tenancy_ocidlocal="<oci-tenancy-ocid>"
compartment_ocidlocal="<oci-compartment-ocid>"
region_identifierlocal="<oci-region-for-example-eu-amsterdam-1>"
ai_endpoint_regionlocal="<oci-genai-region-for-example-eu-amsterdam-1>"
oci_auth_typelocal="api_key"
PG_AI_PROFILE_AUTO_SETUP=true
# Optional names for the OCI GenAI-backed webshop return advisor. Override these
# only when its database profile or agent team must use tenancy-specific names.
# webshop_return_agent_profile_namelocal="PG_RETURN_AGENT_PROFILE"
# webshop_return_agent_team_namelocal="RETURN_ADVISOR_TEAM"
# These names and models have working defaults. Override only when required.
# oci_genai_modellocal="cohere.command-a-03-2025"
# oci_genai_embedding_modellocal="cohere.embed-v4.0"
# oci_ai_profile_namelocal="PG_GENAI_PROFILE"
# oci_genai_credential_namelocal="PG_OCI_GENAI_CRED"

# Required installation artifacts. Supply your own build and GoldenGate URLs.

GGSA_OSA_ARCHIVE_URL="<read-only-goldengate-osa-archive-url>"
# Globally accessible ADW-enabled Gravitino distribution with ADWCatalog support and build zip - DO NOT CHANGE
GRAVITINO_ICEBERG_REST_SERVER_ARCHIVE_URL="https://objectstorage.us-ashburn-1.oraclecloud.com/p/BLGnG9scPeB_z2ruM-xirgDXNfBMuYjTRciZG8jcwgu68oCodk_vFq1vySIDG-F_/n/c4u04/b/ai-lh-build/o/gravitino-iceberg-rest-server-0.7.0-incubating-SNAPSHOT-bin.zip"
BUILD_ARCHIVE_URL="https://objectstorage.us-ashburn-1.oraclecloud.com/p/DBotL5o3bbC7DIow0amxkomoF4ubcIsDy6CQYDm3CxHY-amMFZH9B_osICr4X1S2/n/c4u04/b/ai-lh-build/o/build_dev.zip"

# Required for unattended Oracle Container Registry login. Leave both empty only
# when an operator will complete the interactive podman login.
CON_USER=""
CON_TOK=""

# Gravitino Iceberg REST catalog settings for Data Transforms.
# GRAVITINO_JDBC_PASSWORD is generated from DBPASSWORD.
GRAVITINO_CATALOG_BACKEND_NAME="TEST_ICEBERG"
GRAVITINO_JDBC_USER="PG"

# OCI Object Storage S3-compatible settings used by Iceberg S3FileIO.
GRAVITINO_OBJECT_STORAGE_BUCKET="<iceberg-object-storage-bucket>"
GRAVITINO_OBJECT_STORAGE_PREFIX="iceberg"
# GRAVITINO_WAREHOUSE is generated from the provisioned bucket and prefix.
GRAVITINO_S3_ENDPOINT="https://<object-storage-namespace>.compat.objectstorage.<region>.oraclecloud.com"
GRAVITINO_S3_REGION="<region>"
#set in OCI console in user profile
GRAVITINO_S3_ACCESS_KEY_ID="<customer-secret-key-id>"
GRAVITINO_S3_SECRET_ACCESS_KEY="<customer-secret-key-secret>"

# Data Transforms connection provisioning. The default password is DBPASSWORD;
# set DATA_TRANSFORMS_PASSWORD only when it differs from the ADB ADMIN password.
DATA_TRANSFORMS_ADB_AUTO_CONFIGURE=true
DATA_TRANSFORMS_ADB_USERNAME="PG"
DATA_TRANSFORMS_ICEBERG_AUTO_CREATE=true
DATA_TRANSFORMS_ICEBERG_CONNECTION_NAME="pg-iceberg"
DATA_TRANSFORMS_ICEBERG_CATALOG_NAME="default"
DATA_TRANSFORMS_ICEBERG_CATALOG_PROVIDER="genericrestcatalog"
DATA_TRANSFORMS_ICEBERG_REST_PATH="/iceberg"
# Create the PeakGear Data Transforms demo project and its prepared objects.
DATA_TRANSFORMS_DEMO_AUTO_CREATE=true
# Remove and recreate only the named PeakGear Data Transforms demo objects.
DATA_TRANSFORMS_DEMO_RESET=true
DATA_TRANSFORMS_DEMO_PROJECT_NAME="peakgear"
DATA_TRANSFORMS_DEMO_DATA_FLOW_NAME="dataFlow"
DATA_TRANSFORMS_DEMO_DATA_FLOW_SOURCE_TABLE="PRODUCT_MASTER_RAW_ICEBERG_EXT"
DATA_TRANSFORMS_DEMO_DATA_FLOW_TARGET_TABLE="GOLD_PRODUCTS"
DATA_TRANSFORMS_DEMO_DATA_LOAD_NAME="dataLoad"
DATA_TRANSFORMS_DEMO_DATA_LOAD_SOURCE_TABLE="GOLD_PRODUCTS"
# DATA_TRANSFORMS_PASSWORD="<data-transforms-password-if-different>"
# DATA_TRANSFORMS_BASE_URL="https://<adb-host>-<db-name>.adb.<region>.oraclecloudapps.com"
# DATA_TRANSFORMS_ICEBERG_REST_URL="http://<vm-public-ip>:1525/iceberg"

# Optional advanced overrides. The defaults above are suitable for a standard
# deployment; set these only for a nonstandard catalogue, archive name, or port.
# GRAVITINO_ICEBERG_REST_SERVER_ARCHIVE="<archive-file-name>"
GRAVITINO_REST_PORT=1525
GRAVITINO_HTTP_PORT=1525
# GRAVITINO_JDBC_SERVICE_NAME="<adb-wallet-service-name>"
# GRAVITINO_JDBC_URI="jdbc:oracle:thin:@<service>?TNS_ADMIN=/wallet"
GRAVITINO_S3_PATH_STYLE_ACCESS=true

# LiveLabs setup is deliberately disabled for own-tenancy deployments. Enable
# it only for a trusted LiveLabs build and provide its explicit script URL.
ENABLE_LIVELABS_FIRSTBOOT=false
# LIVELABS_FIRSTBOOT_URL="<trusted-https-firstboot-script-url>"
